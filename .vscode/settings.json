{
    // CMake Tools settings
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.configureOnOpen": true,
    "cmake.generator": "Ninja",

    // Use clangd for fast indexing (disable MS C++ intellisense if using clangd)
    "C_Cpp.intelliSenseEngine": "disabled",

    // clangd settings for better performance
    "clangd.arguments": [
        "--background-index",
        "--clang-tidy",
        "--compile-commands-dir=${workspaceFolder}/build",
        "--header-insertion=never",
        "-j=4"
    ],

    // Files to exclude from watching (improves performance)
    "files.watcherExclude": {
        "**/build/**": true,
        "**/JUCE/**": true,
        "**/modules/**": true
    }
}
